CSS

/* Home page sections */
.section {
    margin-top: 30px;
}

.section h2 {
    border-bottom: 2px solid rgba(255, 255, 255, 0.4);
    padding-bottom: 5px;
}

/* Anime cards */
.cards {
    display: flex;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 15px;
}

.card {
    background-color: rgba(0, 0, 0, 0.3);
    padding: 20px;
    border-radius: 10px;
    flex: 1;
    min-width: 220px;
}

.card h3 {
    margin-top: 0;
}



